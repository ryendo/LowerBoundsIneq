#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N thin-ray-full
#PBS -q normal
#PBS -l nodes=1:ppn=1
#PBS -l mem=4gb
#PBS -l walltime=01:00:00
#PBS -o thin_rayleigh_full.stdout
#PBS -e thin_rayleigh_full.stderr

set -euo pipefail
cd "$PBS_O_WORKDIR"

SOURCE_DIR="${THIN_SOURCE_DIR:-$PBS_O_WORKDIR/source}"
export INTLAB_ROOT="${INTLAB_ROOT:-/home/rendo/tmp/Intlab_V12_nqc_01}"
export VER10_CERTIFICATE_ROOT="${VER10_CERTIFICATE_ROOT:-$PBS_O_WORKDIR/certificate-output}"
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

test -d "$SOURCE_DIR/.git"
test -f "$INTLAB_ROOT/startintlab.m"
mkdir -p "$VER10_CERTIFICATE_ROOT"
cd "$SOURCE_DIR"
matlab -batch "run('scripts_run/run_muhat1_rayleigh_hpc.m')"
